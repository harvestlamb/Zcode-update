# ZCode 内网镜像 — 环境配置
# 拷贝为 .env 后按内网实际情况修改:  cp .env.example .env

# ===== 本地大模型 (OpenAI 兼容接口) =====
# 必填。本地部署的模型服务地址(不含 /chat/completions)。
# Ollama 示例:   http://host.docker.internal:11434/v1
# vLLM 示例:     http://192.168.1.100:8000/v1
# Xinference:    http://192.168.1.100:9997/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1

# 必填。模型名称(需与本地服务里登记的一致)。
LLM_MODEL=glm-4-flash

# 若本地服务需要鉴权则填写,否则保留默认。
LLM_API_KEY=not-required

# 内部默认参数（管理后台不再暴露这些项；一般无需改）。
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# ===== 可选:向量检索(默认用 BM25 关键词检索,无需此项) =====
# 配置后将启用 OpenAI 兼容 /v1/embeddings + 余弦相似度检索,回答质量更好。
# 不配置则自动回退到 BM25(对几十篇文档足够,且零依赖)。
# EMBEDDINGS_BASE_URL=http://192.168.1.100:9997/v1
# EMBEDDINGS_MODEL=bge-large-zh
# EMBEDDINGS_API_KEY=not-required

# ===== Web 端口 =====
WEB_PORT=8090

# ===== 管理后台 =====
# 部署后访问 http://<IP>:8090/admin ，默认账号 admin / admin。
# LLM 配置在管理页修改后会热生效（无需重启容器），并持久化到
# intranet/config/llm.json（独立卷，导入新内容不会覆盖）。
# 上面的 LLM_* 仅作为首次启动的出厂默认值。
